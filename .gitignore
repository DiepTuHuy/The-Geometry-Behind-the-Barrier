# Checkpoints and large archives -- never committed.
# GitHub hard-blocks files over 100 MB. None of this is needed to reproduce a
# figure: every required CSV is in data/.
*.pt
*.pth
ckpt_*/
*.zip

# Logs
*.log

# Torchvision downloads -- the scripts fetch these automatically.
# data/ holds the released CSVs, so the rules are targeted, not blanket.
data/MNIST/
data/FashionMNIST/
data/cifar-10-batches-py/
src/*/data/
